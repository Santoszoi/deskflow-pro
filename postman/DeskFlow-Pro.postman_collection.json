{"info":{"name":"DeskFlow Pro API","description":"Coleção de testes básicos da API de chamados","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"variable":[{"key":"baseUrl","value":"http://localhost:3001"}],"item":[{"name":"Health check","request":{"method":"GET","url":"{{baseUrl}}/api/health"},"event":[{"listen":"test","script":{"exec":["pm.test('API responde 200', () => pm.response.to.have.status(200));"]}}]},{"name":"Listar chamados","request":{"method":"GET","url":"{{baseUrl}}/api/tickets"},"event":[{"listen":"test","script":{"exec":["pm.test('Retorna lista', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"]}}]},{"name":"Criar chamado","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\":\"Erro de acesso ao sistema\",\"description\":\"Teste via Postman\",\"category\":\"Acesso\",\"priority\":\"Alta\",\"status\":\"Aberto\",\"assignee\":\"Marcos\",\"requester\":\"Ana\"}"},"url":"{{baseUrl}}/api/tickets"},"event":[{"listen":"test","script":{"exec":["pm.test('Criado com sucesso', () => pm.response.to.have.status(201));","pm.collectionVariables.set('ticketId', pm.response.json().id);"]}}]},{"name":"Editar chamado","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"Em andamento\"}"},"url":"{{baseUrl}}/api/tickets/{{ticketId}}"}},{"name":"Excluir chamado","request":{"method":"DELETE","url":"{{baseUrl}}/api/tickets/{{ticketId}}"}}]}
